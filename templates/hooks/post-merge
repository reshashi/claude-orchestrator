#!/usr/bin/env bash
# Post-merge hook: Record merge and track TODO/FIXME items
# Installed by claude-orchestrator
#
# This hook runs after a successful merge to track quality suggestions.

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

BACKLOG_SCRIPT="$HOME/.claude/scripts/backlog.sh"

# Only proceed if backlog script exists
if [ ! -f "$BACKLOG_SCRIPT" ]; then
    exit 0
fi

echo -e "\n${BLUE}[Post-Merge] Recording merge in backlog system...${NC}"

# Get merge info
COMMIT_MSG=$(git log -1 --pretty=%B)

# Record the merge as a project task completion (if it looks like a feature)
if [[ "$COMMIT_MSG" =~ ^(feat|feature|fix|refactor): ]]; then
    TASK_DESC=$(echo "$COMMIT_MSG" | head -1 | sed 's/^[a-z]*: //')
    echo -e "${GREEN}✓ Merge recorded: $TASK_DESC${NC}"
fi

# Check for TODO/FIXME comments in recently changed source files
CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || echo "")

TODO_COUNT=0
for file in $CHANGED_FILES; do
    # Skip non-source files, hooks, and review scripts themselves
    case "$file" in
        *.sh|*.ts|*.tsx|*.js|*.jsx|*.py) ;;
        *) continue ;;
    esac

    # Skip hook templates and review/quality scripts
    case "$file" in
        templates/hooks/*|scripts/auto-*|scripts/backlog*) continue ;;
    esac

    if [ -f "$file" ]; then
        while IFS= read -r line; do
            # Extract the actual TODO/FIXME text after the keyword
            todo_text=$(echo "$line" | sed -E 's/^.*\b(TODO|FIXME)[[:space:]]*:?[[:space:]]*//' | sed 's/^[[:space:]]*//' | head -c 100)

            # Skip if extracted text is too short, empty, or looks like code
            if [ ${#todo_text} -lt 10 ]; then
                continue
            fi
            if echo "$todo_text" | grep -qE '^\$|^\{|^[_A-Z]+\(|^\*\/|^-->'; then
                continue
            fi

            "$BACKLOG_SCRIPT" add "TODO in $file: $todo_text" --priority suggestion --source review >/dev/null 2>&1 || true
            TODO_COUNT=$((TODO_COUNT + 1))
        done < <(grep -nE '\b(TODO|FIXME)\b' "$file" 2>/dev/null | grep -v '^\s*#.*grep' || true)
    fi
done

if [ $TODO_COUNT -gt 0 ]; then
    echo -e "${YELLOW}⚠ Found $TODO_COUNT TODO/FIXME comments - added to backlog${NC}"
    echo "  Run '~/.claude/scripts/backlog.sh list' to see them"
fi

# Post Slack deploy summary for master merges
CURRENT_BRANCH=$(git branch --show-current)
if [ "$CURRENT_BRANCH" = "master" ]; then
    echo -e "${BLUE}[Post-Merge] Triggering Slack deploy notification...${NC}"
    if [ -n "$SLACK_BOT_TOKEN" ] && [ -n "$SLACK_PRODUCT_INBOX_CHANNEL" ]; then
        COMMIT_SHA=$(git log -1 --pretty=%h)
        COMMIT_AUTHOR=$(git log -1 --pretty=%an)
        SLACK_POST="$HOME/.claude/scripts/slack-post.sh"
        if [ -x "$SLACK_POST" ]; then
            "$SLACK_POST" \
                --channel "$SLACK_PRODUCT_INBOX_CHANNEL" \
                --text ":rocket: *Deploy: ${COMMIT_MSG}*\nby ${COMMIT_AUTHOR} (\`${COMMIT_SHA}\`)" \
                && echo -e "${GREEN}✓ Slack notification sent${NC}" \
                || echo -e "${YELLOW}⚠ Slack notification failed (CI step will cover it)${NC}"
        else
            echo -e "${YELLOW}⚠ slack-post.sh not found — CI step will handle notification${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ SLACK env vars not set — CI step will handle notification${NC}"
    fi
fi

echo -e "${GREEN}✓ Post-merge hooks complete${NC}\n"
