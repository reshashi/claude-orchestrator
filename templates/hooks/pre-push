#!/usr/bin/env bash
# Pre-push hook: Run comprehensive quality checks before pushing
# Installed by claude-orchestrator
#
# Quality flow:
#   1. Build & type check
#   2. Lint
#   3. Tests
#   4. Security audit
#   5. Auto-review (heuristic /review) - blocks on critical, adds suggestions to backlog
#   6. Auto-qcode check (heuristic /qcode) - warns on fixable issues
#
# To bypass (use sparingly): git push --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Scripts location
SCRIPTS_DIR="$HOME/.claude/scripts"
AUTO_REVIEW="$SCRIPTS_DIR/auto-review.sh"
AUTO_QCODE="$SCRIPTS_DIR/auto-qcode.sh"

echo -e "${BLUE}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║           PRE-PUSH QUALITY GATES                             ║${NC}"
echo -e "${BLUE}╚══════════════════════════════════════════════════════════════╝${NC}"

FAILED=0
WARNINGS=0

# ============================================================
# SECTION 1: Build & Type Check
# ============================================================
echo -e "\n${YELLOW}[1/6] Build & Type Check${NC}"

if [ -f "package.json" ]; then
    SCRIPTS=$(node -e "console.log(Object.keys(require('./package.json').scripts || {}).join(' '))" 2>/dev/null || echo "")

    if echo "$SCRIPTS" | grep -qw "build"; then
        echo "  Running npm run build..."
        if npm run build 2>&1 | tail -5; then
            echo -e "  ${GREEN}✓ Build passed${NC}"
        else
            echo -e "  ${RED}✗ Build failed${NC}"
            FAILED=1
        fi
    elif echo "$SCRIPTS" | grep -qw "type-check"; then
        echo "  Running npm run type-check..."
        if npm run type-check 2>&1 | tail -5; then
            echo -e "  ${GREEN}✓ Type check passed${NC}"
        else
            echo -e "  ${RED}✗ Type check failed${NC}"
            FAILED=1
        fi
    else
        echo -e "  ${YELLOW}⚠ No build/type-check script found${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# ============================================================
# SECTION 2: Lint
# ============================================================
echo -e "\n${YELLOW}[2/6] Lint${NC}"

if [ -f "package.json" ]; then
    SCRIPTS=$(node -e "console.log(Object.keys(require('./package.json').scripts || {}).join(' '))" 2>/dev/null || echo "")

    if echo "$SCRIPTS" | grep -qw "lint"; then
        echo "  Running npm run lint..."
        if npm run lint 2>&1 | tail -10; then
            echo -e "  ${GREEN}✓ Lint passed${NC}"
        else
            echo -e "  ${RED}✗ Lint failed${NC}"
            FAILED=1
        fi
    else
        echo -e "  ${YELLOW}⚠ No lint script found${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# ============================================================
# SECTION 3: Tests
# ============================================================
echo -e "\n${YELLOW}[3/6] Tests${NC}"

if [ -f "package.json" ]; then
    SCRIPTS=$(node -e "console.log(Object.keys(require('./package.json').scripts || {}).join(' '))" 2>/dev/null || echo "")

    if echo "$SCRIPTS" | grep -qw "test:run"; then
        echo "  Running npm run test:run..."
        if npm run test:run 2>&1 | tail -10; then
            echo -e "  ${GREEN}✓ Tests passed${NC}"
        else
            echo -e "  ${RED}✗ Tests failed${NC}"
            FAILED=1
        fi
    elif echo "$SCRIPTS" | grep -qw "test"; then
        echo "  Running npm test..."
        if npm test 2>&1 | tail -10; then
            echo -e "  ${GREEN}✓ Tests passed${NC}"
        else
            echo -e "  ${RED}✗ Tests failed${NC}"
            FAILED=1
        fi
    else
        echo -e "  ${YELLOW}⚠ No test script found${NC}"
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# ============================================================
# SECTION 4: Security Audit
# ============================================================
echo -e "\n${YELLOW}[4/6] Security Audit${NC}"

if [ -f "package.json" ]; then
    echo "  Running npm audit..."
    AUDIT_OUTPUT=$(npm audit --audit-level=high 2>&1) || true

    if echo "$AUDIT_OUTPUT" | grep -q "found 0 vulnerabilities"; then
        echo -e "  ${GREEN}✓ No high/critical vulnerabilities${NC}"
    elif echo "$AUDIT_OUTPUT" | grep -qE "high|critical"; then
        HIGH_COUNT=$(echo "$AUDIT_OUTPUT" | grep -oE "[0-9]+ high" | head -1 || echo "0 high")
        CRIT_COUNT=$(echo "$AUDIT_OUTPUT" | grep -oE "[0-9]+ critical" | head -1 || echo "0 critical")
        echo -e "  ${RED}✗ Security vulnerabilities: $HIGH_COUNT, $CRIT_COUNT${NC}"
        echo "  Run 'npm audit' for details"
        # Don't fail on security - just warn (can be pre-existing)
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "  ${GREEN}✓ No high/critical vulnerabilities${NC}"
    fi
fi

# ============================================================
# SECTION 5: Auto-Review (heuristic /review)
# ============================================================
echo -e "\n${YELLOW}[5/6] Auto-Review (static analysis)${NC}"

if [ -x "$AUTO_REVIEW" ]; then
    echo "  Running auto-review.sh --add-to-backlog..."

    # Run auto-review, capture exit code
    # Critical issues cause exit 1, which we catch
    if "$AUTO_REVIEW" --add-to-backlog 2>&1 | grep -E '^\s*\[|✓|✗' | head -20; then
        echo -e "  ${GREEN}✓ Auto-review passed (no critical issues)${NC}"
    else
        echo -e "  ${RED}✗ Auto-review found critical issues${NC}"
        echo "  Fix critical issues before pushing."
        FAILED=1
    fi
else
    echo -e "  ${YELLOW}⚠ auto-review.sh not found at $AUTO_REVIEW${NC}"
    WARNINGS=$((WARNINGS + 1))
fi

# ============================================================
# SECTION 6: Auto-Qcode Check (heuristic /qcode)
# ============================================================
echo -e "\n${YELLOW}[6/6] Auto-Qcode Check${NC}"

if [ -x "$AUTO_QCODE" ]; then
    echo "  Running auto-qcode.sh (check mode)..."

    # Run in dry-run mode to see if there are fixable issues
    QCODE_OUTPUT=$("$AUTO_QCODE" --fix --dry-run 2>&1) || true

    if echo "$QCODE_OUTPUT" | grep -q "fixes available"; then
        FIX_COUNT=$(echo "$QCODE_OUTPUT" | grep -oE "[0-9]+ fix" | head -1 || echo "some")
        echo -e "  ${YELLOW}⚠ $FIX_COUNT available - run 'auto-qcode.sh --fix' to apply${NC}"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "  ${GREEN}✓ No auto-fixable issues${NC}"
    fi
else
    echo -e "  ${YELLOW}⚠ auto-qcode.sh not found at $AUTO_QCODE${NC}"
    WARNINGS=$((WARNINGS + 1))
fi

# ============================================================
# SUMMARY
# ============================================================
echo -e "\n${BLUE}══════════════════════════════════════════════════════════════${NC}"

if [ $FAILED -eq 0 ]; then
    if [ $WARNINGS -gt 0 ]; then
        echo -e "${GREEN}✓ All quality gates passed${NC} (${YELLOW}$WARNINGS warnings${NC})"
    else
        echo -e "${GREEN}✓ All quality gates passed!${NC}"
    fi
    echo -e "${BLUE}══════════════════════════════════════════════════════════════${NC}\n"
    exit 0
else
    echo -e "${RED}✗ Quality gates failed. Fix the issues above.${NC}"
    echo -e "${RED}  To bypass (not recommended): git push --no-verify${NC}"
    echo -e "${BLUE}══════════════════════════════════════════════════════════════${NC}\n"
    exit 1
fi
