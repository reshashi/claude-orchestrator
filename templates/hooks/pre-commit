#!/usr/bin/env bash
# Pre-commit hook: Run quality checks before allowing commits
# Installed by claude-orchestrator
#
# To bypass (use sparingly): git commit --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit quality checks...${NC}"

# Track if any check fails
FAILED=0

# --- Section 0: Branch Guard ---
# Prevent commits on wrong branch in worktree sessions
BRANCH_GUARD="$HOME/.claude/scripts/branch-guard.sh"
if [ -x "$BRANCH_GUARD" ]; then
    echo -e "\n${YELLOW}[0] Checking branch guard...${NC}"
    if "$BRANCH_GUARD" --check-only 2>&1; then
        echo -e "${GREEN}✓ Branch guard passed${NC}"
    else
        echo -e "${RED}✗ Branch guard BLOCKED this commit${NC}"
        echo -e "${RED}  You are on the wrong branch for this worktree.${NC}"
        echo -e "${RED}  Run: $BRANCH_GUARD for recovery instructions.${NC}"
        exit 1
    fi
fi

# Check if package.json exists (Node.js project)
if [ -f "package.json" ]; then
    # Get list of available scripts
    SCRIPTS=$(node -e "console.log(Object.keys(require('./package.json').scripts || {}).join(' '))" 2>/dev/null || echo "")

    # Run type-check if available
    if echo "$SCRIPTS" | grep -qw "type-check"; then
        echo -e "\n${YELLOW}[1/3] Running type-check...${NC}"
        if npm run type-check --silent 2>&1; then
            echo -e "${GREEN}✓ Type check passed${NC}"
        else
            echo -e "${RED}✗ Type check failed${NC}"
            FAILED=1
        fi
    elif echo "$SCRIPTS" | grep -qw "typecheck"; then
        echo -e "\n${YELLOW}[1/3] Running typecheck...${NC}"
        if npm run typecheck --silent 2>&1; then
            echo -e "${GREEN}✓ Type check passed${NC}"
        else
            echo -e "${RED}✗ Type check failed${NC}"
            FAILED=1
        fi
    elif echo "$SCRIPTS" | grep -qw "build"; then
        # Fall back to build which usually includes type checking
        echo -e "\n${YELLOW}[1/3] Running build (includes type check)...${NC}"
        if npm run build --silent 2>&1; then
            echo -e "${GREEN}✓ Build passed${NC}"
        else
            echo -e "${RED}✗ Build failed${NC}"
            FAILED=1
        fi
    else
        echo -e "\n${YELLOW}[1/3] Skipping type-check (no script found)${NC}"
    fi

    # Run lint if available
    if echo "$SCRIPTS" | grep -qw "lint"; then
        echo -e "\n${YELLOW}[2/3] Running lint...${NC}"
        if npm run lint --silent 2>&1; then
            echo -e "${GREEN}✓ Lint passed${NC}"
        else
            echo -e "${RED}✗ Lint failed${NC}"
            FAILED=1
        fi
    else
        echo -e "\n${YELLOW}[2/3] Skipping lint (no script found)${NC}"
    fi

    # Run tests if available (only staged file tests if possible)
    if echo "$SCRIPTS" | grep -qw "test"; then
        echo -e "\n${YELLOW}[3/3] Running tests...${NC}"
        # Try to run only related tests, fall back to all tests
        if echo "$SCRIPTS" | grep -qw "test:run"; then
            if npm run test:run --silent 2>&1; then
                echo -e "${GREEN}✓ Tests passed${NC}"
            else
                echo -e "${RED}✗ Tests failed${NC}"
                FAILED=1
            fi
        else
            if npm test --silent 2>&1; then
                echo -e "${GREEN}✓ Tests passed${NC}"
            else
                echo -e "${RED}✗ Tests failed${NC}"
                FAILED=1
            fi
        fi
    else
        echo -e "\n${YELLOW}[3/3] Skipping tests (no script found)${NC}"
    fi
fi

# Check for Python projects
if [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
    if command -v ruff &> /dev/null; then
        echo -e "\n${YELLOW}Running ruff...${NC}"
        if ruff check . 2>&1; then
            echo -e "${GREEN}✓ Ruff passed${NC}"
        else
            echo -e "${RED}✗ Ruff failed${NC}"
            FAILED=1
        fi
    fi

    if command -v pytest &> /dev/null; then
        echo -e "\n${YELLOW}Running pytest...${NC}"
        if pytest --tb=short 2>&1; then
            echo -e "${GREEN}✓ Pytest passed${NC}"
        else
            echo -e "${RED}✗ Pytest failed${NC}"
            FAILED=1
        fi
    fi
fi

# Check for secrets (basic check)
echo -e "\n${YELLOW}Checking for potential secrets...${NC}"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
SECRET_PATTERNS="(password|secret|api_key|apikey|token|credential).*=.*['\"][^'\"]+['\"]"

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if grep -iE "$SECRET_PATTERNS" "$file" 2>/dev/null | grep -v "example\|sample\|test\|mock" > /dev/null; then
            echo -e "${RED}✗ Potential secret found in: $file${NC}"
            echo "  Review the file and ensure no real secrets are being committed."
            FAILED=1
        fi
    fi
done

if [ $FAILED -eq 0 ]; then
    echo -e "\n${GREEN}✓ All pre-commit checks passed!${NC}\n"
else
    echo -e "\n${RED}✗ Pre-commit checks failed. Fix the issues above or use --no-verify to bypass.${NC}\n"
    exit 1
fi
