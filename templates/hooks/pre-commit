#!/usr/bin/env bash
# Pre-commit hook: Fast checks only (~5s)
# Heavy checks (type-check, full lint, tests, build) are in pre-push.
# Installed by claude-orchestrator
#
# To bypass (use sparingly): git commit --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

FAILED=0

# --- Section 0: Branch Guard ---
BRANCH_GUARD="$HOME/.claude/scripts/branch-guard.sh"
if [ -x "$BRANCH_GUARD" ]; then
    echo -e "\n${YELLOW}[1/3] Checking branch guard...${NC}"
    if "$BRANCH_GUARD" --check-only 2>&1; then
        echo -e "${GREEN}✓ Branch guard passed${NC}"
    else
        echo -e "${RED}✗ Branch guard BLOCKED this commit${NC}"
        echo -e "${RED}  You are on the wrong branch for this worktree.${NC}"
        echo -e "${RED}  Run: $BRANCH_GUARD for recovery instructions.${NC}"
        exit 1
    fi
fi

# --- Section 1: Secret Detection on Staged Files ---
echo -e "\n${YELLOW}[2/3] Checking for potential secrets...${NC}"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
SECRET_PATTERNS="(password|secret|api_key|apikey|token|credential).*=.*['\"][^'\"]+['\"]"

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if grep -iE "$SECRET_PATTERNS" "$file" 2>/dev/null | grep -v "example\|sample\|test\|mock" > /dev/null; then
            echo -e "${RED}✗ Potential secret found in: $file${NC}"
            echo "  Review the file and ensure no real secrets are being committed."
            FAILED=1
        fi
    fi
done

if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓ No secrets detected${NC}"
fi

# --- Section 2: Lint Staged .ts/.tsx Files Only ---
if [ -f "package.json" ]; then
    STAGED_TS=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)
    if [ -n "$STAGED_TS" ]; then
        SCRIPTS=$(node -e "console.log(Object.keys(require('./package.json').scripts || {}).join(' '))" 2>/dev/null || echo "")
        if echo "$SCRIPTS" | grep -qw "lint"; then
            echo -e "\n${YELLOW}[3/3] Linting staged files...${NC}"
            # Pass only staged .ts/.tsx files to eslint via next lint
            if npx eslint --no-warn-ignored $STAGED_TS 2>&1; then
                echo -e "${GREEN}✓ Lint passed (staged files)${NC}"
            else
                echo -e "${RED}✗ Lint failed on staged files${NC}"
                FAILED=1
            fi
        else
            echo -e "\n${YELLOW}[3/3] Skipping lint (no script found)${NC}"
        fi
    else
        echo -e "\n${YELLOW}[3/3] No .ts/.tsx files staged, skipping lint${NC}"
    fi
fi

if [ $FAILED -eq 0 ]; then
    echo -e "\n${GREEN}✓ All pre-commit checks passed!${NC}\n"
else
    echo -e "\n${RED}✗ Pre-commit checks failed. Fix the issues above.${NC}\n"
    exit 1
fi
