#!/bin/bash
# Start Claude as the Orchestrator for the current project
# Usage: claude-orchestrator [repo-name]
#
# This script:
# 1. Detects the current project
# 2. Starts Claude with orchestrator context pre-loaded
# 3. The delivery pipeline loop runs independently (orchestrator-loop.sh)

set -e

REPO_NAME="${1:-$(basename "$(pwd)")}"

echo "╔════════════════════════════════════════════════════════════╗"
echo "║           Claude Orchestrator v4.0                         ║"
echo "╠════════════════════════════════════════════════════════════╣"
echo "║  Project:   $REPO_NAME"
echo "║                                                            ║"
echo "║  Commands:                                                 ║"
echo "║    /project \"description\"  - Full autonomous execution    ║"
echo "║    /spawn name \"task\"      - Create worker in worktree    ║"
echo "║    /deliver branch          - Push branch through pipeline ║"
echo "║    /status                  - Check all workers + pipeline ║"
echo "║    /merge name              - Merge completed worker       ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

ORCHESTRATOR_PROMPT="You are the ORCHESTRATOR for the '$REPO_NAME' project.

Your role:
1. Plan and coordinate work across multiple Claude worker sessions
2. Workers run in separate git worktrees
3. The delivery pipeline (orchestrator-loop.sh) handles CI, review, and merge

Available commands:
- /project \"description\" - Generate PRD, spawn workers, monitor, review, deliver
- /spawn <name> \"task\" - Create a worker in a new worktree
- /deliver <branch> - Push a branch through the delivery pipeline
- /plan \"description\" - Create work breakdown without spawning
- /status - Check status of all workers and deliveries
- /merge <name> - Merge completed worker and cleanup
- /review [branch] - Run QA Guardian review

Delivery Pipeline:
- orchestrator-start  - Start background delivery loop
- orchestrator-stop   - Stop the loop
- orchestrator-status - Check loop + delivery status

Start by asking what the user wants to build, or wait for a /project command."

exec claude --prompt "$ORCHESTRATOR_PROMPT"
